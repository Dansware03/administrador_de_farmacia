# SIMAP - Reglas de Servidor Apache y Manejo de Errores HTTP
# Clínica Popular Especializada La Fría

# Desactivar exploración de directorios
Options -Indexes

# Protección de archivos sensibles y base de datos SQLite
<FilesMatch "(simap\.db|schema\.sql|simap_completa\.sql|\.json|\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Configuración de Páginas de Error Personalizadas
ErrorDocument 400 /administrador_de_farmacia/error.php?code=400
ErrorDocument 401 /administrador_de_farmacia/error.php?code=401
ErrorDocument 403 /administrador_de_farmacia/error.php?code=403
ErrorDocument 404 /administrador_de_farmacia/error.php?code=404
ErrorDocument 405 /administrador_de_farmacia/error.php?code=405
ErrorDocument 500 /administrador_de_farmacia/error.php?code=500
ErrorDocument 503 /administrador_de_farmacia/error.php?code=503
